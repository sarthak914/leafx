# Copy this file to ".env" in the same folder as app.py and fill in what you need.
# Never commit ".env" or paste API keys into chat.

# Gemini API key for the farming assistant (free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Optional: Gemini model to use (default gemini-2.5-flash)
# GEMINI_MODEL=

# Optional: trained weights (absolute, or relative to app.py)
# PLANTDOC_CLS_WEIGHTS=runs/classify/train/weights/best.pt
# PLANTDOC_WEIGHTS=runs/detect/train/weights/best.pt

# Optional: key that signs login cookies (a random one is generated in .flask_secret if empty)
# FLASK_SECRET_KEY=
